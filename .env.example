# Server listening port inside container / Kubernetes Pod
PORT=3000

# Public HTTPS origin used in generated QR invite links and Chromecast TV URLs
# Example: https://splendor.example.com
PUBLIC_BASE_URL=

# Comma-separated allowed CORS origins for Socket.IO (leave empty for same-origin / permissive default)
# Example: https://splendor.example.com,https://appassets.androidplatform.net
CORS_ORIGIN=

# Optional client build-time Socket.IO server origin (leave empty when web UI and server share the same HTTPS host)
VITE_SERVER_URL=
